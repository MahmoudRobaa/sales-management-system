# PostgreSQL Configuration
POSTGRES_USER=salesadmin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=sales_management
POSTGRES_PORT=5432

# pgAdmin Configuration (optional)
PGADMIN_EMAIL=admin@yourcompany.com
PGADMIN_PASSWORD=your_pgadmin_password
PGADMIN_PORT=5050

# Backend Configuration
DATABASE_URL=postgresql://salesadmin:your_secure_password_here@localhost:5432/sales_management

# Security - REQUIRED (min 32 chars)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_real_secret_key_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Environment: development | staging | production
ENVIRONMENT=development
